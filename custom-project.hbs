{{!< default}}

{{#post}}
<main id="site-main" class="site-main">
    <article class="article {{post_class}}">
        <header class="article-header gh-canvas">
            {{#primary_tag}}
            <div class="article-tag post-card-tags">
                <span class="post-card-primary-tag"><a href="{{url}}">{{name}}</a></span>
            </div>
            {{/primary_tag}}
            <h1 class="article-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
            <p class="project-repository"><a href="{{@site.url}}/projects/{{slug}}/repo/">View repository</a></p>

            {{#if feature_image}}
            <figure class="article-image">
                <img
                    srcset="{{img_url feature_image size="s"}} 300w,
                            {{img_url feature_image size="m"}} 600w,
                            {{img_url feature_image size="l"}} 1000w,
                            {{img_url feature_image size="xl"}} 2000w"
                    sizes="(min-width: 1400px) 1400px, 92vw"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    fetchpriority="high"
                    loading="eager"
                />
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
            {{/if}}
        </header>

        <section class="gh-content gh-canvas">
            {{content}}
        </section>
    </article>
</main>

{{#get "posts" filter="tag:hash-project-{{slug}}+tag:-hash-project+tag:-hash-training" include="tags,authors" limit="100" as |related_posts|}}
    {{#if related_posts}}
    <aside class="project-related outer">
        <div class="inner">
            <h2>Related posts</h2>
            <div class="project-related-feed">
                {{#foreach related_posts}}
                    {{> "post-card"}}
                {{/foreach}}
            </div>
        </div>
    </aside>
    {{/if}}
{{else}}
    <p class="outer">Related posts could not be loaded.</p>
{{/get}}
{{/post}}
