{{!< default}}
{{!-- The tag above means - insert everything in this file into the {body} of the default.hbs template --}}

<main id="site-main" class="site-main outer">
<div class="inner posts">

    {{#author}}
    {{#get "posts" filter="authors:{{slug}}+tag:-hash-project+tag:-hash-training" include="tags,authors" limit=@config.posts_per_page page=../pagination.page}}
    <div class="post-feed">

        {{#with ..}}
        <section class="post-card post-card-large">

            {{#if cover_image}}
            <div class="post-card-image-link">
                {{!-- This is a responsive image, it loads different sizes depending on device
                https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
                <img class="post-card-image"
                    srcset="{{img_url cover_image size="s"}} 300w,
                            {{img_url cover_image size="m"}} 600w,
                            {{img_url cover_image size="l"}} 1000w,
                            {{img_url cover_image size="xl"}} 2000w"
                    sizes="(max-width: 1000px) 400px, 800px"
                    src="{{img_url cover_image size="m"}}"
                    alt="{{title}}"
                    fetchpriority="high"
                    loading="eager"
                />
            </div>
            {{/if}}

            <div class="post-card-content">
            <div class="post-card-content-link">

                {{#if profile_image}}
                    <img class="author-profile-pic" src="{{profile_image}}" alt="{{name}}" loading="eager" />
                {{/if}}

                <header class="post-card-header">
                    <h1 class="post-card-title">{{name}}</h1>
                </header>

                {{#if bio}}
                    <div class="post-card-excerpt">{{bio}}</div>
                {{/if}}

            <footer class="author-profile-footer">
                {{#if location}}
                    <div class="author-profile-location">{{location}}</div>
                {{/if}}
                <div class="author-profile-meta">
                    {{#if website}}
                        <a class="author-profile-social-link author-profile-website" href="{{website}}" target="_blank" rel="noopener me">{{website}}</a>
                    {{/if}}
                    {{#match slug "!=" "jesse-houwing"}}
                        {{> "social-links" source=this link_class="author-profile-social-link"}}
                    {{/match}}
                    {{{block "links"}}}
                </div>
            </footer>

            </div>
            </div>

        </section>
        {{/with}}

        {{#foreach posts}}
            {{!-- The tag below includes the markup for each post - partials/post-card.hbs --}}
            {{> "post-card"}}
        {{/foreach}}

    </div>

    {{#match pagination.page ">" pagination.pages}}
        <p>{{t "There are no posts on this page."}} <a href="{{page_url pagination.pages}}">{{t "View the last page of posts"}}</a>.</p>
    {{else}}
        {{pagination}}
    {{/match}}
    {{else}}
        <p>{{t "Posts could not be loaded."}}</p>
    {{/get}}
    {{/author}}
    
</div>
</main>
