<article class="project-card training-card {{#has tag="#training-phoenix-project"}}training-card--phoenix {{/has}}{{#match slug "psm-pspo-professional-scrum-master-and-product-owner"}}training-card--round {{/match}}{{post_class}}">
    {{#if feature_image}}
    <a class="post-card-image-link" href="{{#if custom_template}}{{url}}{{else}}{{@site.url}}/training/{{slug}}/register/{{/if}}" aria-label="{{title}}">
        <img class="post-card-image"
            srcset="{{img_url feature_image size="s"}} 300w,
                    {{img_url feature_image size="m"}} 600w,
                    {{img_url feature_image size="l"}} 1000w"
            sizes="(max-width: 767px) 92vw, (max-width: 991px) 45vw, 30vw"
            src="{{img_url feature_image size="m"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            loading="lazy"
        />
    </a>
    {{/if}}
    <div class="project-card-content">
        <h3 class="post-card-title"><a href="{{#if custom_template}}{{url}}{{else}}{{@site.url}}/training/{{slug}}/register/{{/if}}">{{title}}</a></h3>
        {{#if excerpt}}<div class="post-card-excerpt">{{excerpt}}</div>{{/if}}
        <div class="project-card-links">
            {{#if custom_template}}<a href="{{url}}">View course</a>{{/if}}
            <a href="{{@site.url}}/training/{{slug}}/register/">{{#has tag="#training-contact"}}Contact{{else}}Register{{/has}}</a>
        </div>
    </div>
</article>
